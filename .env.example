# ==============================================================================
# TrustFlow AI - Environment Variables
# Copy this file to .env or .env.local and populate with your sandbox credentials.
# Never commit real credentials, OAuth tokens, or secrets to Git.
# ==============================================================================

# Database (SQLite for local MVP)
DATABASE_URL="file:./dev.db"

# App Base URL
APP_BASE_URL="http://localhost:3000"

# AI Provider (Optional - deterministic billing intelligence fallback works out-of-the-box)
GEMINI_API_KEY=""

# PayPal REST Invoicing Sandbox Credentials (Optional - deterministic demo mode available)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID=""

